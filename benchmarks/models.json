    { "id": "claude-sonnet-5-5", "provider": "anthropic", "vendor": "Anthropic", "model": "claude-sonnet-5-5",
      "apiKeyEnv": "ANTHROPIC_API_KEY", "price": { "inputPerMTok": null, "outputPerMTok": null } },
    { "id": "claude-haiku-5-5", "provider": "anthropic", "vendor": "Anthropic", "model": "claude-haiku-5-5",
      "apiKeyEnv": "ANTHROPIC_API_KEY", "price": { "inputPerMTok": null, "outputPerMTok": null } },

