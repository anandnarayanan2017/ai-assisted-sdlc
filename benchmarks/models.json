{
  "$comment": "Models under comparison. Keys come from the env var named in apiKeyEnv (never put a key here). Fill price from each vendor's pricing page (USD per million tokens) to get the cost column; null shows n/a. Check model ids against each vendor's current model list before a run.",
  "models": [
    { "id": "reference", "provider": "reference", "vendor": "baseline",
      "notes": "Canonical solutions (codegen) / recorded turns (sdlc). Must score 100% on codegen: proves the tests and the sandbox work." },
